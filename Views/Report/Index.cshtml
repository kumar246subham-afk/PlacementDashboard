@model PlacementDashboard.Models.DashboardStats
@{
    ViewData["Title"] = "Crystal Reports Center";
    var depts = ViewBag.Departments as List<string> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-file-earmark-bar-graph-fill text-primary me-2"></i>Crystal Reports Center
        </h2>
        <p class="text-muted mb-0">Generate, group, filter and print institutional placement audit reports</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Report 1: Department-wise Placement Offer Report -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100 border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-file-earmark-text-fill me-2"></i>Department-wise Placement Report</h5>
                <small>Grouped by Academic Department &bull; Crystal Reports Layout</small>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    Generates a formal, printable placement report with college header, grouped by student departments, showing individual student offers, department sub-totals, and institutional grand totals.
                </p>

                <form asp-action="PlacementReport" method="get" class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">Filter Department:</label>
                        <select name="department" class="form-select form-select-sm">
                            <option value="">All Departments</option>
                            @foreach (var d in depts)
                            {
                                <option value="@d">@d</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">Batch Year:</label>
                        <input type="text" name="batch" class="form-control form-control-sm" placeholder="e.g. 2024-2025" />
                    </div>
                    <div class="col-12 mt-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-printer me-1"></i> Generate & Preview Report
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Report 2: Company-wise Recruiter Report -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100 border-info">
            <div class="card-header bg-info text-dark">
                <h5 class="mb-0"><i class="bi bi-building-check me-2"></i>Recruiter Drives & Offers Report</h5>
                <small>Grouped by Recruiting Corporate Partner</small>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    Corporate recruiter audit report documenting every visiting company, hiring numbers, packages offered, drive dates, and student selections.
                </p>

                <div class="mt-4 pt-3 text-center">
                    <a asp-action="CompanyWiseReport" class="btn btn-info text-dark fw-semibold px-4 w-100">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Open Recruiter Report
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Architecture & Crystal Reports Concept Card for Evaluation -->
<div class="card shadow-sm">
    <div class="card-header bg-dark text-white">
        <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Crystal Reports Features Implemented in this Module</h6>
    </div>
    <div class="card-body">
        <div class="row g-3 small">
            <div class="col-md-3">
                <h6 class="fw-bold text-primary mb-1">1. Report Header</h6>
                <p class="text-muted">Institutional crest, report title, campus code, and document timestamp.</p>
            </div>
            <div class="col-md-3">
                <h6 class="fw-bold text-primary mb-1">2. Grouping & Subtotals</h6>
                <p class="text-muted">Grouped by <code>Department</code> with calculated count and average package per branch.</p>
            </div>
            <div class="col-md-3">
                <h6 class="fw-bold text-primary mb-1">3. Report Footer</h6>
                <p class="text-muted">Campus grand totals, highest CTC offered, institutional average package.</p>
            </div>
            <div class="col-md-3">
                <h6 class="fw-bold text-primary mb-1">4. Print Media Engine</h6>
                <p class="text-muted">CSS <code>@@media print</code> rules that strip navigation and format for standard A4 printing.</p>
            </div>
        </div>
    </div>
</div>
