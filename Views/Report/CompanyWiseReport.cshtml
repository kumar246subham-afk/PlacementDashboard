@model List<PlacementDashboard.Models.Company>
@{
    ViewData["Title"] = "Corporate Recruiter Report";
    var placedStudents = ViewBag.Students as List<PlacementDashboard.Models.Student> ?? new();
}

<div class="card shadow-sm mb-4 no-print">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-2"><i class="bi bi-arrow-left"></i> Reports Hub</a>
            <span class="badge bg-info text-dark">Recruiter Audit Report</span>
        </div>
        <button onclick="window.print()" class="btn btn-success btn-sm">
            <i class="bi bi-printer-fill me-1"></i> Print / Save PDF
        </button>
    </div>
</div>

<div class="card shadow crystal-report-container bg-white p-4 p-md-5 mb-5" style="border: 1px solid #cbd5e1; border-radius: 4px;">
    <!-- Report Header -->
    <div class="text-center pb-3 mb-4" style="border-bottom: 3px double #1e293b;">
        <h4 class="fw-bold text-uppercase mb-1">ABC INSTITUTE OF ENGINEERING & TECHNOLOGY</h4>
        <div class="bg-dark text-white py-1 my-2 text-uppercase fw-bold" style="letter-spacing: 2px;">
            CAMPUS RECRUITERS & CORPORATE VISITS REPORT
        </div>
        <div class="d-flex justify-content-between text-muted small px-2">
            <span><strong>Total Companies Visited:</strong> @Model.Count</span>
            <span><strong>Generated Date:</strong> @DateTime.Now.ToString("dd MMMM yyyy")</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-sm align-middle mb-4" style="font-size: 0.9rem;">
            <thead style="background-color: #f1f5f9;">
                <tr>
                    <th>#</th>
                    <th>Company Name</th>
                    <th>Industry / Domain</th>
                    <th class="text-center">Min CGPA</th>
                    <th class="text-end">Package (LPA)</th>
                    <th class="text-center">Students Recruited</th>
                    <th>Drive Date</th>
                    <th>Location</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="text-center">@(i++)</td>
                        <td class="fw-bold">@c.CompanyName</td>
                        <td>@c.Industry</td>
                        <td class="text-center">@c.MinCGPA</td>
                        <td class="text-end fw-bold text-success">₹@c.PackageOffered LPA</td>
                        <td class="text-center fw-bold">@c.StudentsHired</td>
                        <td>@c.DriveDate.ToString("dd-MMM-yyyy")</td>
                        <td>@(c.Location ?? "Campus")</td>
                    </tr>
                }
            </tbody>
            <tfoot style="background-color: #f8fafc; font-weight: bold;">
                <tr>
                    <td colspan="5" class="text-end">Total Offers Generated across all visiting companies:</td>
                    <td class="text-center text-primary fs-6">@Model.Sum(c => c.StudentsHired)</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Signatures -->
    <div class="pt-5 mt-4">
        <div class="row text-center">
            <div class="col-6">
                <div style="border-top: 1px dashed #64748b; padding-top: 8px;">
                    <p class="fw-bold mb-0">Training & Placement Officer</p>
                    <small class="text-muted">Corporate Relations Cell</small>
                </div>
            </div>
            <div class="col-6">
                <div style="border-top: 1px dashed #64748b; padding-top: 8px;">
                    <p class="fw-bold mb-0">Principal</p>
                    <small class="text-muted">ABC Institute of Technology</small>
                </div>
            </div>
        </div>
    </div>
</div>
