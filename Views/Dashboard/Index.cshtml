@model PlacementDashboard.Models.DashboardStats
@{
    ViewData["Title"] = "Campus Placement Dashboard";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Campus Placement Dashboard
        </h2>
        <p class="text-muted mb-0">Overview of student placements, recruiters, and branch-wise statistics</p>
    </div>
    <div class="btn-group shadow-sm">
        <a asp-controller="Report" asp-action="PlacementReport" class="btn btn-outline-primary">
            <i class="bi bi-file-earmark-pdf me-1"></i> Crystal Report
        </a>
        <a asp-controller="Student" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-1"></i> Register Student
        </a>
    </div>
</div>

<!-- 6 KPI Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-2">
        <div class="card stat-card bg-primary text-white shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 small mb-1">TOTAL STUDENTS</h6>
                    <h3 class="fw-bold mb-0">@Model.TotalStudents</h3>
                </div>
                <i class="bi bi-people fs-2 text-white-50"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="card stat-card bg-success text-white shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 small mb-1">PLACED STUDENTS</h6>
                    <h3 class="fw-bold mb-0">@Model.PlacedStudents</h3>
                </div>
                <i class="bi bi-check-circle fs-2 text-white-50"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="card stat-card bg-danger text-white shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 small mb-1">UNPLACED</h6>
                    <h3 class="fw-bold mb-0">@Model.UnplacedStudents</h3>
                </div>
                <i class="bi bi-hourglass-split fs-2 text-white-50"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="card stat-card bg-info text-dark shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-dark-50 small mb-1">PLACEMENT RATE</h6>
                    <h3 class="fw-bold mb-0">@Model.PlacementPercentage%</h3>
                </div>
                <i class="bi bi-percent fs-2 text-dark-50"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="card stat-card bg-warning text-dark shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-dark-50 small mb-1">HIGHEST (LPA)</h6>
                    <h3 class="fw-bold mb-0">₹@Model.HighestPackage</h3>
                </div>
                <i class="bi bi-trophy fs-2 text-dark-50"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="card stat-card bg-secondary text-white shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50 small mb-1">AVG PACKAGE</h6>
                    <h3 class="fw-bold mb-0">₹@Model.AveragePackage</h3>
                </div>
                <i class="bi bi-graph-up-arrow fs-2 text-white-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Charts & Department Breakdown (Repeater Control Style) -->
<div class="row g-4 mb-4">
    <!-- Chart: Placed vs Unplaced Ratio -->
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Placement Status Ratio</h6>
            </div>
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <div style="width: 230px; height: 230px;">
                    <canvas id="statusChart"></canvas>
                </div>
                <div class="mt-3 text-center small text-muted">
                    <span class="badge bg-success me-2">Placed: @Model.PlacedStudents</span>
                    <span class="badge bg-danger">Unplaced: @Model.UnplacedStudents</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Control: Repeater Style - Department Wise Placement Performance -->
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-diagram-3-fill text-info me-2"></i>Department-wise Placement Performance
                </h6>
                <span class="badge bg-light text-dark border">Data Control: Repeater View</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Department</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">Placed</th>
                                <th>Progress / Rate</th>
                                <th class="text-end">Avg Package</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model.DepartmentBreakdown)
                            {
                                <tr>
                                    <td class="fw-semibold">@dept.Department</td>
                                    <td class="text-center">@dept.TotalStudents</td>
                                    <td class="text-center"><span class="badge bg-success">@dept.PlacedCount</span></td>
                                    <td style="min-width: 180px;">
                                        <div class="d-flex align-items-center">
                                            <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @dept.PlacementRate%"></div>
                                            </div>
                                            <small class="fw-bold">@dept.PlacementRate%</small>
                                        </div>
                                    </td>
                                    <td class="text-end fw-bold text-primary">₹@dept.AvgPackage LPA</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Data Controls: GridView Style Recent Placements + DataList Style Top Recruiters -->
<div class="row g-4 mb-4">
    <!-- GridView Style: Recent Student Placements -->
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-award-fill text-warning me-2"></i>Recent Campus Placements
                </h6>
                <a asp-controller="Student" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    View GridView <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Roll No</th>
                                <th>Student</th>
                                <th>Department</th>
                                <th>Company</th>
                                <th>Package</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.RecentPlacements)
                            {
                                <tr>
                                    <td><code>@student.RollNumber</code></td>
                                    <td class="fw-semibold">@student.StudentName</td>
                                    <td><span class="badge bg-light text-dark border">@student.Department</span></td>
                                    <td><strong>@student.CompanyName</strong></td>
                                    <td><span class="badge bg-success">₹@student.Package LPA</span></td>
                                    <td><small class="text-muted">@(student.OfferDate?.ToString("dd-MMM-yyyy") ?? "N/A")</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- DataList / Card Style: Top Hiring Companies -->
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-buildings text-danger me-2"></i>Top Recruiters</h6>
                <a asp-controller="Company" asp-action="Index" class="btn btn-sm btn-outline-secondary">All</a>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    @foreach (var company in Model.TopRecruiters)
                    {
                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0 fw-semibold">@company.CompanyName</h6>
                                <small class="text-muted">@company.Industry &bull; Min CGPA: @company.MinCGPA</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-primary rounded-pill">₹@company.PackageOffered LPA</span>
                                <div><small class="text-success fw-bold">@company.StudentsHired Hired</small></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Chart.js Doughnut Chart for Placement Ratio
    const ctx = document.getElementById('statusChart').getContext('2d');
    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Placed', 'Unplaced'],
            datasets: [{
                data: [@Model.PlacedStudents, @Model.UnplacedStudents],
                backgroundColor: ['#10b981', '#ef4444'],
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
</script>
}
