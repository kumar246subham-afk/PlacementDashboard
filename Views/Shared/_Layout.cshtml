<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - College Placement Dashboard</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Chart.js for Interactive Dashboard Charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
            color: #fff;
            padding-top: 1rem;
        }
        .sidebar .nav-link {
            color: #cbd5e1;
            font-weight: 500;
            padding: 0.8rem 1.25rem;
            border-radius: 8px;
            margin: 0.2rem 0.6rem;
            transition: all 0.2s ease-in-out;
            display: flex;
            align-items: center;
        }
        .sidebar .nav-link i {
            font-size: 1.2rem;
            margin-right: 0.75rem;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: #fff;
            background: rgba(59, 130, 246, 0.25);
            border-left: 4px solid #3b82f6;
        }
        .brand-header {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 1rem;
        }
        .stat-card {
            border: none;
            border-radius: 12px;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.12) !important;
        }
        /* Crystal Reports Print Styling */
        @@media print {
            .no-print, .sidebar, header, footer {
                display: none !important;
            }
            body {
                background: white !important;
            }
            .content-area {
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .crystal-report-container {
                box-shadow: none !important;
                border: 1px solid #ccc !important;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar Navigation -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar no-print">
                <div class="brand-header text-center">
                    <h5 class="fw-bold mb-1 text-white">
                        <i class="bi bi-mortarboard-fill text-primary me-2"></i>Campus Placement
                    </h5>
                    <small class="text-secondary">ASP.NET Data Controls & Reports</small>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Student" asp-action="Index">
                            <i class="bi bi-people-fill"></i> Students (GridView)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Company" asp-action="Index">
                            <i class="bi bi-building-check"></i> Companies
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Report" asp-action="Index">
                            <i class="bi bi-file-earmark-bar-graph-fill"></i> Crystal Reports
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Report" asp-action="PlacementReport">
                            <i class="bi bi-printer-fill"></i> Print Offer Report
                        </a>
                    </li>
                </ul>

                <div class="px-3 mt-4 pt-3 border-top border-secondary text-secondary small">
                    <p class="mb-1"><i class="bi bi-database me-1"></i><strong>ADO.NET Connected</strong></p>
                    <p class="mb-1"><i class="bi bi-table me-1"></i>GridView & Repeater</p>
                    <p class="mb-0"><i class="bi bi-file-text me-1"></i>Crystal Report Engine</p>
                </div>
            </nav>

            <!-- Main Page Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4 content-area">
                <!-- Top Notification Alerts -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show no-print shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show no-print shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
