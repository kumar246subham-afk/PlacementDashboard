@model List<PlacementDashboard.Models.Student>
@{
    ViewData["Title"] = "Student Records (Data Control: GridView)";
    var depts = ViewBag.Departments as List<string> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>Students Directory
        </h2>
        <span class="badge bg-dark">ASP.NET Data Control: GridView Pattern</span>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Add New Student
        </a>
    </div>
</div>

<!-- Search & Filtering Toolbar (SqlDataAdapter Disconnected Search) -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                           placeholder="Search by student name, roll number, or company..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="department" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var d in depts)
                    {
                        <option value="@d" selected="@(ViewBag.SelectedDepartment == d)">@d</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Placed" selected="@(ViewBag.SelectedStatus == "Placed")">Placed</option>
                    <option value="Unplaced" selected="@(ViewBag.SelectedStatus == "Unplaced")">Unplaced</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-fill">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- GridView Table -->
<div class="card shadow-sm">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table me-2"></i>Student Records (@Model.Count entries)</span>
        <small class="text-secondary">ADO.NET SqlDataReader / SqlDataAdapter Bound Grid</small>
    </div>
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-search fs-1 d-block mb-2"></i>
                <p>No matching student records found.</p>
                <a asp-action="Index" class="btn btn-sm btn-outline-primary">Reset Filters</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-secondary">
                        <tr>
                            <th>#</th>
                            <th>Roll Number</th>
                            <th>Student Name</th>
                            <th>Department</th>
                            <th class="text-center">CGPA</th>
                            <th class="text-center">Batch</th>
                            <th>Status</th>
                            <th>Recruiter / Package</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.StudentId</td>
                                <td><span class="badge bg-light text-dark border">@s.RollNumber</span></td>
                                <td class="fw-bold">@s.StudentName</td>
                                <td>@s.Department</td>
                                <td class="text-center">
                                    <span class="badge @(s.CGPA >= 8.5m ? "bg-success" : s.CGPA >= 7.0m ? "bg-primary" : "bg-warning text-dark")">
                                        @s.CGPA
                                    </span>
                                </td>
                                <td class="text-center"><small class="text-muted">@s.BatchYear</small></td>
                                <td>
                                    @if (s.PlacementStatus == "Placed")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Placed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Unplaced</span>
                                    }
                                </td>
                                <td>
                                    @if (s.PlacementStatus == "Placed")
                                    {
                                        <strong>@s.CompanyName</strong>
                                        <div><small class="text-success fw-bold">₹@s.Package LPA</small></div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">&mdash;</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@s.StudentId" class="btn btn-outline-info" title="DetailsView">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@s.StudentId" class="btn btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@s.StudentId" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
