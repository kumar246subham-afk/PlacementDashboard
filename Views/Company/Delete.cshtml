@model PlacementDashboard.Models.Company
@{
    ViewData["Title"] = "Delete Company";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
    <h2 class="fw-bold mb-0 text-danger">Delete Company</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Company Removal</h5>
            </div>
            <div class="card-body">
                <p>Are you sure you want to remove <strong>@Model.CompanyName</strong>?</p>
                <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CompanyId" />
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
