@model PlacementDashboard.Models.Company
@{
    ViewData["Title"] = "Edit Company";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
    <h2 class="fw-bold mb-0">Update Company Details</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Edit @Model.CompanyName</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CompanyId" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                            <input asp-for="CompanyName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Industry" class="form-label fw-semibold"></label>
                            <input asp-for="Industry" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MinCGPA" class="form-label fw-semibold"></label>
                            <input asp-for="MinCGPA" class="form-control" type="number" step="0.1" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PackageOffered" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹ LPA</span>
                                <input asp-for="PackageOffered" class="form-control" type="number" step="0.1" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="StudentsHired" class="form-label fw-semibold"></label>
                            <input asp-for="StudentsHired" class="form-control" type="number" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DriveDate" class="form-label fw-semibold"></label>
                            <input class="form-control" type="date" name="DriveDate" value="@Model.DriveDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label fw-semibold"></label>
                            <input asp-for="Location" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Website" class="form-label fw-semibold"></label>
                            <input asp-for="Website" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
